<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Daily scheduled flow. Creates a reminder Task on Space Tenants whose tenancy End Date is 90, 30 or 7 days away and who are still the current tenant. Adjust the day thresholds in the Reminder Due decision, or swap the Task action for an email alert, to suit the org.</description>
    <environments>Default</environments>
    <formulas>
        <name>TenancyDaysToExpiry</name>
        <dataType>Number</dataType>
        <scale>0</scale>
        <expression>{!$Record.End_Date__c} - TODAY()</expression>
    </formulas>
    <formulas>
        <name>TenancyTaskSubject</name>
        <dataType>String</dataType>
        <expression>"Tenancy ending on " &amp; TEXT({!$Record.End_Date__c}) &amp; " (" &amp; TEXT(TenancyDaysToExpiry) &amp; " days) — review renewal or exit"</expression>
    </formulas>
    <interviewLabel>TTS - Tenancy Expiry Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TTS - Tenancy Expiry Reminder</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <decisions>
        <name>Reminder_Due</name>
        <label>Reminder Due</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>No Reminder</defaultConnectorLabel>
        <rules>
            <name>Due</name>
            <conditionLogic>(1 OR 2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>TenancyDaysToExpiry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>90.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TenancyDaysToExpiry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>TenancyDaysToExpiry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>7.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Tenant__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Reminder_Task</targetReference>
            </connector>
            <label>Due</label>
        </rules>
    </decisions>
    <recordCreates>
        <name>Create_Reminder_Task</name>
        <label>Create Reminder Task</label>
        <locationX>176</locationX>
        <locationY>396</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Record.End_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>TenancyTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Reminder_Due</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>End_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>TTS_Space_Tenant__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-01-01</startDate>
            <startTime>00:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
