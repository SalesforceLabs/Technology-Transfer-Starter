            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>TTS_Space_Tenant__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Occupancy_Decision</name>
        <label>Occupancy Decision</label>
        <locationX>176</locationX>
        <locationY>516</locationY>
        <defaultConnectorLabel>No Change</defaultConnectorLabel>
        <rules>
            <name>Set_To_Occupied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Tenants</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Space.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Unoccupied</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Occupied</targetReference>
            </connector>
            <label>Set To Occupied</label>
        </rules>
        <rules>
            <name>Set_To_Unoccupied</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Tenants</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Space.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Occupied</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Unoccupied</targetReference>
            </connector>
            <label>Set To Unoccupied</label>
        </rules>
    </decisions>
