<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>After a Space Tenant is created or updated, sets the parent Space status to Occupied or Unoccupied based on whether any current tenancies remain. Counts active sibling tenancies directly (Current_Tenant = true) instead of the Total Occupants roll-up, so it does not depend on roll-up timing or roll-up field access. Only toggles between Occupied and Unoccupied; manual statuses (Reserved, Hold, Closed for Maintenance, No Longer In Use) are left untouched. Deliberately reacts on the child, not the Space, and does not run on delete: the only delete trigger is before-delete, which would fault trying to update the parent while the Space itself is being deleted in a cascade.</description>
    <environments>Default</environments>
    <interviewLabel>TTS - Space Auto Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TTS - Space Auto Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
