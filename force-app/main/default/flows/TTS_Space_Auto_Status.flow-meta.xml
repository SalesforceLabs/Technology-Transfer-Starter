        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Space__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Space__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Current_Tenant__c</field>
            <operator>EqualTo</operator>
